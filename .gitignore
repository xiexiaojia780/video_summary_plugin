# Python 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# 类型检查器缓存
.mypy_cache/
.ruff_cache/
.pytest_cache/

# 编辑器 / IDE
.vscode/
.idea/
*.swp

# 日志 / 本地数据 / 密钥
*.log
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# 运行时配置（由 Runner 根据 config_model 自动生成，不提交）
/config.toml

# 临时视频/抽帧
/temp/
/runtime/

# 系统文件
.DS_Store
Thumbs.db
